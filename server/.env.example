# Example server environment variables
# Set MONGO_URI to your MongoDB Atlas connection string or local MongoDB URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.<cluster>.mongodb.net/Deadly_AG
# Optional comma-separated DNS servers for mongodb+srv connections
MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
PORT=5000
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_NAME=Deadly Cycle Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Vercel Blob (public store). On Vercel, connecting the store adds BLOB_STORE_ID
# automatically - do not set it by hand. For local development, copy the store's
# read-write token here (Vercel -> Storage -> your store -> .env.local tab).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
